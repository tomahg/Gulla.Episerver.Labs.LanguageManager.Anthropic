<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Gulla.Episerver.Labs.LanguageManager.Anthropic</Title>
    <PackageId>Gulla.Episerver.Labs.LanguageManager.Anthropic</PackageId>
    <Authors>Tomas Hensrud Gulla</Authors>
    <Version>2.0.0</Version>
    <PackageVersion>2.0.0</PackageVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Description>An addon for EPiServer.Labs.LanguageManager that enables translation using Anthropic Claude.</Description>
    <PackageTags>Optimizely LanguageManager AI Translation Anthropic Claude Translator</PackageTags>
    <PackageProjectUrl>https://github.com/tomahg/Gulla.Episerver.Labs.LanguageManager.Anthropic/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tomahg/Gulla.Episerver.Labs.LanguageManager.Anthropic/</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Initial release</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EPiServer.Labs.LanguageManager" Version="[6.0.0, 7.0.0)" />
    <PackageReference Include="EPiServer.CMS.UI" Version="[13.0.1, 14.0.0)" />
    <PackageReference Include="Anthropic" Version="[12.29.0, 13.0.0)" />
  </ItemGroup>

</Project>
