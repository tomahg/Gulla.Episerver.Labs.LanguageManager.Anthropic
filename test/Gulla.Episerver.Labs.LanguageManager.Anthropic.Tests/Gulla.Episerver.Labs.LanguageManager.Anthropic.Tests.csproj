<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    The translation logic under test (AnthropicSystemPrompt, AnthropicResponse) is
    pure and dependency-free. The source files are compiled directly into the test
    assembly so the tests stay fast and isolated, without dragging in the
    EPiServer/Anthropic dependencies that the main addon project carries.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\AnthropicSystemPrompt.cs" Link="AnthropicSystemPrompt.cs" />
    <Compile Include="..\..\src\AnthropicResponse.cs" Link="AnthropicResponse.cs" />
  </ItemGroup>

</Project>
